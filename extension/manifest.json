{
  "manifest_version": 3,
  "name": "Shopee Analytics Pro - Thống Kê Chi Tiêu & Quản Lý Đơn Hàng",
  "short_name": "Shopee Analytics",
  "version": "2.2.0",
  "description": "Tiện ích phân tích và thống kê chi tiết số tiền bạn đã mua sắm trên Shopee theo từng tháng và năm. Trải nghiệm ngay!",
  "minimum_chrome_version": "95",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "🔍 Mở Shopee Analytics Pro"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
