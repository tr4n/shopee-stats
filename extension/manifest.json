{
  "manifest_version": 3,
  "name": "Shopee Analytics Pro - Thống Kê Chi Tiêu & Quản Lý Đơn Hàng",
  "short_name": "Shopee Analytics",
  "version": "2.1.0",
  "description": "Tiện ích phân tích và thống kê chi tiết số tiền bạn đã mua sắm trên Shopee theo từng tháng và năm. Trải nghiệm ngay!",
  "minimum_chrome_version": "88",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://shopee.vn/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "🔍 Mở Shopee Analytics Pro"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
